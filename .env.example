# Copy to .env. Fill the admin key, embedding key and chosen LLM key.
# Never commit .env.
LIMEM_ADMIN_API_KEY=
DEEPSEEK_API_KEY=
# Self-hosted LLM: set the server key; use not-required only without server auth.
LLM_API_KEY=
DASHSCOPE_API_KEY=

# Docker Compose host binding; these do not change model settings.
LIMEM_BIND_HOST=127.0.0.1
LIMEM_PORT=8012
